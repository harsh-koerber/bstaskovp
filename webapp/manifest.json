        "settings": {
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#PICK",
          "entitySet": "ZHRZ_DD_I_BAL_PICK",
          "title": "Picking",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#PICK"
        }
      },
      "STAGING": {
        "template": "sap.ovp.cards.charts.analytical",
        "model": "mainModel",
        "settings": {
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#STAGING",
          "entitySet": "ZHRZ_DD_I_BAL_STAGING",
          "title": "Staging",
