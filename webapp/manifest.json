    },
    "chartSettings": {},
    "bHeaderExpanded": false,
    "dataLoadSettings": {
      "loadDataOnAppLaunch": "always"
    },
    "refreshIntervalInMinutes": 1
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  }
